name: loading_builder
description: "A simple Flutter package providing reusable loading widgets including a button loading indicator, a centered circular progress loader, and a shimmer loading placeholder. Easily enhance your app's loading states with customizable and lightweight components."
version: 0.0.6
homepage: https://github.com/GenieCoderSrc/loading_builder
repository: https://github.com/GenieCoderSrc/loading_builder
issue_tracker: https://github.com/GenieCoderSrc/loading_builder/issues


environment:
  sdk: \x27>=3.6.0 <4.0.0\x27
  resolution: workspace
    flutter: ">=3.0.0"
